# Open new windows at a fixed size instead of restoring previous ones.
# window-save-state only covers relaunch; on macOS, Ghostty also reuses the
# last window's frame for new windows unless an explicit size is set.
window-save-state = never
window-width = 100
window-height = 30

# Open new terminals in ~ instead of the last directory used.
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false

# Install Ghostty's terminfo on SSH hosts, falling back to xterm-256color.
shell-integration-features = ssh-terminfo,ssh-env
