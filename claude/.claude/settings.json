{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/tyandell/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "permissions": {
    "deny": [
      "mcp__claude_ai_Claude_Docs",
      "Artifact",
      "ArtifactComments",
      "ArtifactData"
    ]
  }
}
